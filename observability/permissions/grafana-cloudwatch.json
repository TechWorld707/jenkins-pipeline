{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Effect": "Allow",
      "Action": [
        "cloudwatch:GetMetricData",
        "cloudwatch:GetMetricStatistics",
        "cloudwatch:ListMetrics",
        "cloudwatch:DescribeAlarms",
        "logs:DescribeLogGroups",
        "cloudwatch:DescribeAlarmHistory",
        "cloudwatch:DescribeAlarmsForMetric"
      ],
      "Resource": "*"
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:StartQuery",
        "logs:FilterLogEvents",
        "logs:GetLogEvents",
        "logs:DescribeLogStreams"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-2:671662643382:log-group:/ecs/webtech-production/*:*",
        "arn:aws:logs:eu-west-2:671662643382:log-group:/webtech/production/*:*",
        "arn:aws:logs:eu-west-2:671662643382:log-group:/webtech-production/vpc-flow-logs:*",
        "arn:aws:logs:eu-west-2:671662643382:log-group:/aws/rds/instance/webtech-production-postgres/*:*",
        "arn:aws:logs:eu-west-2:671662643382:log-group:/aws/codebuild/webtech-shared-image-builder:*",
        "arn:aws:logs:us-east-1:671662643382:log-group:aws-waf-logs-webtech-production:*"
      ]
    },
    {
      "Effect": "Allow",
      "Action": [
        "logs:GetQueryResults",
        "logs:StopQuery"
      ],
      "Resource": "*"
    }
  ]
}
