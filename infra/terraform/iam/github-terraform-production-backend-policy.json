{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ListProductionState",
      "Effect": "Allow",
      "Action": "s3:ListBucket",
      "Resource": "arn:aws:s3:::techworld707-jenkins-pipeline-tfstate-671662643382",
      "Condition": {
        "StringLike": {
          "s3:prefix": "jenkins-pipeline/production/*"
        }
      }
    },
    {
      "Sid": "ReadWriteProductionState",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "arn:aws:s3:::techworld707-jenkins-pipeline-tfstate-671662643382/jenkins-pipeline/production/terraform.tfstate"
    },
    {
      "Sid": "ManageProductionLock",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject",
        "s3:DeleteObject"
      ],
      "Resource": "arn:aws:s3:::techworld707-jenkins-pipeline-tfstate-671662643382/jenkins-pipeline/production/terraform.tfstate.tflock"
    }
  ]
}
