{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ManageCodeBuildLogGroup",
      "Effect": "Allow",
      "Action": [
        "logs:CreateLogGroup",
        "logs:DeleteLogGroup",
        "logs:PutRetentionPolicy",
        "logs:DeleteRetentionPolicy",
        "logs:AssociateKmsKey",
        "logs:DisassociateKmsKey",
        "logs:ListTagsForResource",
        "logs:TagResource",
        "logs:UntagResource",
        "logs:ListTagsLogGroup",
        "logs:TagLogGroup",
        "logs:UntagLogGroup"
      ],
      "Resource": [
        "arn:aws:logs:eu-west-2:671662643382:log-group:/aws/codebuild/webtech-shared-image-builder",
        "arn:aws:logs:eu-west-2:671662643382:log-group:/aws/codebuild/webtech-shared-image-builder:*"
      ]
    },
    {
      "Sid": "ManageCodeBuildServiceRole",
      "Effect": "Allow",
      "Action": [
        "iam:CreateRole",
        "iam:GetRole",
        "iam:UpdateRole",
        "iam:UpdateAssumeRolePolicy",
        "iam:DeleteRole",
        "iam:TagRole",
        "iam:UntagRole",
        "iam:ListRoleTags",
        "iam:ListRolePolicies",
        "iam:ListAttachedRolePolicies",
        "iam:ListInstanceProfilesForRole"
      ],
      "Resource": "arn:aws:iam::671662643382:role/webtech-shared-codebuild-image-builder"
    },
    {
      "Sid": "ManageCodeBuildInlinePolicy",
      "Effect": "Allow",
      "Action": [
        "iam:PutRolePolicy",
        "iam:GetRolePolicy",
        "iam:DeleteRolePolicy"
      ],
      "Resource": "arn:aws:iam::671662643382:role/webtech-shared-codebuild-image-builder"
    },
    {
      "Sid": "PassCodeBuildServiceRole",
      "Effect": "Allow",
      "Action": "iam:PassRole",
      "Resource": "arn:aws:iam::671662643382:role/webtech-shared-codebuild-image-builder",
      "Condition": {
        "StringEquals": {
          "iam:PassedToService": "codebuild.amazonaws.com"
        }
      }
    },
    {
      "Sid": "ManageImageBuilderProject",
      "Effect": "Allow",
      "Action": [
        "codebuild:CreateProject",
        "codebuild:UpdateProject",
        "codebuild:DeleteProject",
        "codebuild:BatchGetProjects"
      ],
      "Resource": "arn:aws:codebuild:eu-west-2:671662643382:project/webtech-shared-image-builder"
    }
  ]
}
